{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mark",
  "version": "0.4.0",
  "identifier": "app.mark.reader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mark",
        "width": 980,
        "height": 740,
        "minWidth": 460,
        "minHeight": 340,
        "resizable": true,
        "center": true,
        "transparent": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "A small, fast markdown reader.",
    "longDescription": "Mark is a lightweight desktop markdown reader with full GitHub-flavored parsing, code highlighting, math, and deep appearance customization.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mkdn", "mdx"],
        "name": "Markdown",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ]
  }
}
